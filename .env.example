# SceneSpec generation provider (backend, server/):
#   claude-cli   (default) — uses your local Claude Code login; NO API key.
#                Requires the `claude` CLI installed and authenticated.
#   messages-api           — raw Anthropic Messages API; needs a per-request key
#                sent from the UI. Bills API credits.
SPEC_PROVIDER=claude-cli

# Optional: model for the claude-cli provider (default: CLI's configured model).
# A cheaper model like claude-haiku-4-5 is fine for the structured SceneSpec.
# SPEC_MODEL=claude-haiku-4-5

# Backend port (frontend dev proxy points here; see vite.config.ts).
PORT=8787
